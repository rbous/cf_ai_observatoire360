{
    "name": "@observatoire360/api",
    "version": "0.0.1",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "wrangler dev",
        "build": "wrangler deploy --dry-run --outdir=dist",
        "deploy": "wrangler deploy",
        "db:generate": "drizzle-kit generate",
        "db:migrate": "wrangler d1 migrations apply observatoire360-db --local",
        "db:migrate:prod": "wrangler d1 migrations apply observatoire360-db --remote",
        "db:seed": "wrangler d1 execute observatoire360-db --local --file=src/db/seed.sql",
        "clean": "rm -rf dist .wrangler"
    },
    "dependencies": {
        "@observatoire360/shared": "workspace:*",
        "drizzle-orm": "^0.39.0",
        "hono": "^4.7.0",
        "jose": "^6.0.0",
        "zod": "^3.24.0"
    },
    "devDependencies": {
        "@cloudflare/workers-types": "^4.20250313.0",
        "drizzle-kit": "^0.30.0",
        "typescript": "^5.8.0",
        "wrangler": "^4.0.0"
    }
}
